    {
      "name": "Create_Employee",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let prefix = \"0161\";\nlet randomNumber = Math.floor(1000000 + Math.random() * 9000000);\nlet Phone = prefix + randomNumber;\npm.environment.set(\"Phone\", Phone);\n\nlet minSalary = 30000;\nlet maxSalary = 100000;\nlet randomSalary = Math.floor(Math.random() * (maxSalary - minSalary + 1)) + minSalary;\npm.environment.set(\"Salary\", randomSalary);\n\nlet department = [\"Engineering\", \"Marketing\", \"Finance\", \"HR\", \"IT\"];\nlet randomDepartment = department[Math.floor(Math.random() * department.length)];  \npm.environment.set(\"Department\", randomDepartment);\n\nlet position = [\"Developer\", \"Manager\", \"Analyst\", \"HR\", \"Tester\"];\nlet randomPosition = position[Math.floor(Math.random() * position.length)];\npm.environment.set(\"Position\", randomPosition);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let jsonData = pm.response.json();\r\n\r\nlet Id = jsonData.data.id;\r\nlet FirstName = jsonData.data.firstName;\r\nlet LastName = jsonData.data.lastName;\r\nlet Email = jsonData.data.email;\r\nlet Phone = jsonData.data.phone;\r\nlet Dept = jsonData.data.department;\r\nlet Position = jsonData.data.position;\r\nlet Salary = jsonData.data.salary;\r\n\r\n\r\npm.environment.set(\"Id\", Id)\r\npm.environment.set(\"FirstName\", FirstName)\r\npm.environment.set(\"LastName\", LastName)\r\npm.environment.set(\"Email\", Email)\r\npm.environment.set(\"Phone\", Phone)\r\npm.environment.set(\"Department\", Dept)\r\npm.environment.set(\"Position\", Position)\r\npm.environment.set(\"Salary\", Salary)    \r\n\r\n\r\n\r\n\r\npm.test(\"Employee Data checking successfully\",()=>{\r\n    pm.expect(jsonData.message).to.eql(\"Employee created successfully\")\r\n})"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{Token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"firstName\": \"{{$randomFirstName}}\",\n    \"lastName\": \"{{$randomLastName}}\",\n    \"email\": \"{{$randomFirstName}}@example.com\",\n    \"phone\": \"{{Phone}}\",\n    \"department\": \"{{Department}}\",\n    \"position\": \"Developer\",\n    \"salary\": \"{{Salary}}\" \n}",
          "options": {
            "raw": {
              "language": "json"
